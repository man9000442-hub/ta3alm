# ============================================================
# ملف المتغيرات البيئية — انسخ هذا الملف إلى .env وضع القيم الحقيقية
# Environment Variables Template — Copy to .env and fill real values
# ============================================================

# --- الإعدادات الأساسية (Core Settings) ---
SECRET_KEY=your-super-secret-key-minimum-50-random-chars-here
DEBUG=False
ALLOWED_HOSTS=ta3alm.online,www.ta3alm.online,localhost,127.0.0.1

# --- قاعدة البيانات (Database) ---
# اختر: sqlite أو postgresql
USE_SQLITE=False
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME

# مثال Supabase:
# DB_NAME=postgres
# DB_USER=postgres.ubejysbctkxloejgjomp
# DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD
# DB_HOST=aws-1-eu-central-1.pooler.supabase.com
# DB_PORT=6543

# --- تخزين الملفات S3 / Supabase Storage (معطل لصالح Cloudinary) ---
# AWS_ACCESS_KEY_ID=your-supabase-s3-access-key
# AWS_SECRET_ACCESS_KEY=your-supabase-s3-secret-key
# AWS_S3_ENDPOINT_URL=https://YOUR_PROJECT_ID.storage.supabase.co/storage/v1/s3
# AWS_STORAGE_BUCKET_NAME=media
# AWS_S3_REGION_NAME=eu-central-1

# --- Cloudinary (تخزين الصور والميديا) ---
# أنشئ حساب مجاني على: https://cloudinary.com/users/register_free
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Paymob (بوابة الدفع) ---
PAYMOB_API_KEY=your-paymob-api-key
PAYMOB_INTEGRATION_ID=0000000
PAYMOB_IFRAME_ID=000000
PAYMOB_WALLET_INTEGRATION_ID=0000000

# --- Bot API (واتساب بوت) ---
# يجب أن يكون 32+ حرف عشوائي قوي
BOT_API_KEY=generate-a-strong-random-key-minimum-32-chars

# --- CORS (النطاقات المسموح بها للـ API) ---
CORS_ALLOWED_ORIGINS=https://ta3alm.online,https://www.ta3alm.online

# --- الـ Cache (يُنصح بـ Redis في الإنتاج) ---
# REDIS_URL=redis://localhost:6379/1

# --- Zoho Mail REST API (OAuth 2.0 للدعم الفني support@ta3alm.online) ---
# احصل عليها من https://api-console.zoho.com (Server-based Applications)
# الـ Redirect URI هو: https://ta3alm.online/ar/admin-panel/support-inbox/oauth2callback/
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REFRESH_TOKEN=optional-refresh-token-or-connect-via-panel
ZOHO_SUPPORT_EMAIL=support@ta3alm.online
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

